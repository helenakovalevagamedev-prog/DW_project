@back Location3 pos:50,150 scale:1
@stop

# KeyMinigameEntry
@disableKey
@hideArrows
@startMinigame result:MinigameWon
@if MinigameWon == 1
    @showUI
    Персонаж: Есть, ключ мой!
    @hideUI
    @addItem id:key
@else
    @showUI
    Персонаж: Не получилось... Попробую ещё раз.
    @hideUI
    @enableKey
@endif
@showArrows
@stop